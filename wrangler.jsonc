{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-assist-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Все внешние URL — из конфига (ADR-0006): в тестах указывают на фейки.
  "vars": {
    "TELEGRAM_API_BASE": "https://api.telegram.org",
    "GOOGLE_API_BASE": "https://www.googleapis.com",
    "GOOGLE_OAUTH_BASE": "https://oauth2.googleapis.com",
    "GOOGLE_ACCOUNTS_BASE": "https://accounts.google.com",
    // Модель Workers AI по OpenAI-совместимому API (ADR-0002). Адрес API (LLM_BASE, содержит account id)
    // и PUBLIC_BASE_URL зависят от деплоя — задаются секретами (scripts/deploy.sh), а не здесь.
    "LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "TEST_MODE": "false"
  },

  "ai": { "binding": "AI" },

  "d1_databases": [
    { "binding": "DB", "database_name": "calendar-assist-bot", "database_id": "0f83ec1b-ff6a-4ffb-bb0e-801245a7294f", "migrations_dir": "migrations" }
  ],

  // Inbox апдейтов Telegram и раздача задач планировщика (ADR-0005 п.6).
  "queues": {
    "producers": [{ "binding": "INBOX", "queue": "cab-inbox" }],
    "consumers": [{ "queue": "cab-inbox", "max_batch_size": 10, "max_retries": 5 }]
  },

  // Планировщик: раз в минуту.
  "triggers": { "crons": ["* * * * *"] },

  // Локальная разработка и тесты (docker compose): без Workers AI — биндинг AI работает только удалённо
  // и требует токена; STT/LLM в тестах заменяются фейками (ADR-0006). Окружения не наследуют биндинги,
  // поэтому D1 и очередь объявлены заново.
  "env": {
    "dev": {
      // Внешние API — фейки из acceptance/ (сервис fakes в compose.yaml).
      // Для работы с настоящим Telegram переопределить в .dev.vars.
      "vars": {
        "TELEGRAM_API_BASE": "http://fakes:9100/telegram",
        "GOOGLE_API_BASE": "http://fakes:9100/google",
        "GOOGLE_OAUTH_BASE": "http://fakes:9100/google-oauth",
        "GOOGLE_ACCOUNTS_BASE": "http://fakes:9100/google-accounts",
        "PUBLIC_BASE_URL": "http://dev:8787",
        "LLM_BASE": "http://fakes:9100/llm/v1",
        "LLM_MODEL": "fake-model",
        "LLM_API_KEY": "test-llm-key",
        "TEST_MODE": "true",
        "GOOGLE_CLIENT_ID": "test-client-id",
        "GOOGLE_CLIENT_SECRET": "test-client-secret",
        // Тестовый ключ (не секрет): 32 байта нулей в base64
        "TOKEN_ENCRYPTION_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "TELEGRAM_BOT_TOKEN": "test-token",
        "TELEGRAM_WEBHOOK_SECRET": "test-secret",
        "ALLOWED_TELEGRAM_IDS": "1001,1002"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "calendar-assist-bot-dev", "database_id": "local", "migrations_dir": "migrations" }
      ],
      "queues": {
        "producers": [{ "binding": "INBOX", "queue": "cab-inbox-dev" }],
        "consumers": [{ "queue": "cab-inbox-dev", "max_batch_size": 10, "max_retries": 5 }]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
