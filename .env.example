# Скопируйте в .env (он в .gitignore) и заполните. Используется для деплоя:
# переменные Cloudflare читает wrangler, остальное загружается в секреты Worker'а (`wrangler secret`).

# --- Cloudflare -----------------------------------------------------------------
# Dashboard → правый столбец на главной странице аккаунта → Account ID
CLOUDFLARE_ACCOUNT_ID=
# My Profile → API Tokens → Create Token (Custom), Entire Account:
#   Workers: Editor (не legacy «Workers Scripts»), D1: Edit, Queues: Edit, Workers AI: Read
#   Если wrangler при деплое попросит больше прав — он назовёт недостающее (например, Account Settings: Read).
CLOUDFLARE_API_TOKEN=

# --- Telegram -------------------------------------------------------------------
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Telegram id через запятую — кому разрешено пользоваться ботом (узнать свой id: @userinfobot)
ALLOWED_TELEGRAM_IDS=
# Алерты эксплуатации (необязательно): chat id, куда бот шлёт «🔴 Алерт» / «✅ Восстановлено» (webhook, inbox, задачи,
# дайджесты, ошибки LLM/STT). Пусто — первому id из ALLOWED_TELEGRAM_IDS. Чат должен хоть раз написать боту /start.
OPS_CHAT_ID=
# Секрет для заголовка webhook — любая случайная строка: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Google ---------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Включить Google Calendar API. Consent Screen → Publishing status: In production.
# Scopes: .../auth/calendar.events, .../auth/calendar.calendarlist.readonly
# Authorized redirect URI: https://<воркер>.workers.dev/oauth/google/callback (адрес появится после первого деплоя)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Push-уведомления Google о изменениях календаря (US-72, ADR-0005 §2) — НЕ в .env: флаг GOOGLE_PUSH_ENABLED в
# wrangler.jsonc (vars), по умолчанию "false" — синк опросом раз в 5–15 мин. Включить ("true") и задеплоить, чтобы
# Google слал уведомления на https://<воркер>.workers.dev/google/push (проверка — docs/research/google-push.md).
# Секретов не нужно: каналы подписываются случайным токеном, который бот хранит в D1.

# --- Шифрование -----------------------------------------------------------------
# Ключ AES-GCM для refresh-токенов Google (32 байта, base64): openssl rand -base64 32
# Не меняйте после деплоя без TOKEN_ENCRYPTION_KEYS_OLD — иначе сохранённые токены не расшифруются и всем придётся переподключиться.
TOKEN_ENCRYPTION_KEY=
# Ротация ключа (необязательно): новый ключ — в TOKEN_ENCRYPTION_KEY, прежний — сюда (несколько — через запятую).
# Шифрует только текущий, расшифровка пробует и прежние; токены перешифруются при переподключении Google.
# Псевдонимы пользователей в /admin выводятся из текущего ключа — после ротации они сменятся.
TOKEN_ENCRYPTION_KEYS_OLD=

# --- LLM ------------------------------------------------------------------------
# Ключ OpenAI-совместимого API. Для Workers AI — API-токен Cloudflare с правом Workers AI
# (можно тот же CLOUDFLARE_API_TOKEN, но лучше отдельный токен только с Workers AI: Read).
LLM_API_KEY=

# --- Внешние провайдеры (необязательно) ------------------------------------------
# Если заданы — основные, Workers AI остаётся запасным (на 429/5xx/таймаут бот переключается сам).
# OpenRouter (https://openrouter.ai/keys): разбор команд. По умолчанию — бесплатные Nemotron 3 Super, затем Gemma 4 26B
# (scripts/deploy.ts: OPENROUTER_DEFAULT; замеры — docs/research/llm-intents-eval.md). Бесплатные модели: ~20 запросов/мин и дневной лимит
# (50/сутки без покупки кредитов, 1000/сутки с $10 на балансе); запросы могут логироваться провайдером.
OPENROUTER_API_KEY=
# Несколько моделей через запятую — по очереди (бесплатные часто перегружены: 429 «rate-limited upstream»).
# Надёжнее платная Gemma (≈ $0.0002 за команду, нужен баланс): google/gemma-4-26b-a4b-it
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
# DeepSeek (https://platform.deepseek.com/api_keys): платный, дешёвый; лучший в замерах 2026-10-08 (98–99% полей, p50 1,1 с).
# Серверы в Китае — до беты указать в privacy policy. Без LLM_PRIMARY=deepseek стоит после бесплатных OpenRouter.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# LLM_PRIMARY=deepseek

# Groq (https://console.groq.com/keys): распознавание голосовых, Whisper large-v3-turbo.
GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Google AI Studio (https://aistudio.google.com/apikey): переслушать голосовое мультимодальной моделью, когда
# текстовый путь ошибся («не так», повтор фразы, «не понимаю» на голосовое). Нет ключа — переслушивания нет.
# Бесплатный тариф: запросы идут на обучение Google — до беты включить биллинг.
# Тот же ключ и модель читают фото и скриншоты (US-66): без ключа бот отвечает «не могу читать картинки».
GEMINI_API_KEY=
# GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
# Запасной для переслушивания через OpenRouter (платно, ≈ $0.0005 за голосовое): google/gemini-3.1-flash-lite
# VOICE_OPENROUTER_MODEL=

# --- Админка --------------------------------------------------------------------
# Страница статистики https://<воркер>/admin (HTTP Basic). Пароль: openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=
