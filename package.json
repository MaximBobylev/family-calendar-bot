{
  "name": "calendar-assist-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p test && tsc --noEmit -p acceptance",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "npm run -s typecheck && biome ci --colors=off",
    "test": "vitest run --dir test",
    "corpus:dates": "tsx scripts/date-corpus.ts",
    "stories": "tsx scripts/story-coverage.ts",
    "acceptance": "tsx acceptance/runner.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true
  }
}
